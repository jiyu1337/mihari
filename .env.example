# Database (Neon Postgres)
# Preferred Vercel Marketplace variables (the prefix depends on integration setup)
NEON_DATABASE_DATABASE_URL=
NEON_DATABASE_POSTGRES_URL=
NEON_DATABASE_URL=

# Legacy/manual fallback; remove after Neon is verified
DATABASE_URL=

# Direct OpenAI API (server-only; never prefix this with NEXT_PUBLIC_)
OPENAI_API_KEY=
MIHARI_AI_MODEL=gpt-5-mini

# Token-gated profile access. One full MHR is the default beta threshold.
MHR_HOLDER_THRESHOLD=1000000

# MIHARI Intelligence API integration controls. Keep values server-only.
# Public read endpoints remain open during beta. The admin key only manages webhook subscriptions.
MIHARI_API_ADMIN_KEY=
# At least 32 characters. Encrypts webhook signing secrets before database storage.
MIHARI_WEBHOOK_ENCRYPTION_KEY=
# Required by the Vercel cron which dispatches signed corporate-action webhooks.
CRON_SECRET=

# Clerk email authentication (Vercel Marketplace creates both automatically)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
WALLET_SESSION_SECRET=

# Robinhood Stock Token API base URL
ROBINHOOD_API_BASE_URL=https://api.robinhood.com

# Robinhood Chain mainnet
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Contract addresses are added after audited mainnet deployment
NEXT_PUBLIC_POLICY_REGISTRY_ADDRESS=
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=
